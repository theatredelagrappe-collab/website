---
layout: layouts/base.njk
permalink: /historique/
eleventyComputed:
  titre: "{{ tgv.historique.titre }}"
  description: "{{ tgv.historique.introduction or tgv.site.description }}"
---
{%- set p = tgv.historique %}
<article class="conteneur section page-texte">
  <h1>{{ p.titre }}</h1>
  {%- if p.introduction %}<p class="chapeau">{{ p.introduction }}</p>{% endif %}
  <div class="texte">{{ p.texte | html | safe }}</div>
  {%- if p.images and p.images.length %}
  {%- asyncEach i in p.images %}
  <figure class="figure-large">{% image i.fichier, i.alt, "(min-width: 48rem) 48rem, 100vw", [600, 1200] %}{% if i.legende %}<figcaption>{{ i.legende }}</figcaption>{% endif %}</figure>
  {%- endeach %}
  {%- endif %}
  <p><a class="lien-fleche" href="/spectacles/">Tous nos spectacles depuis {{ tgv.site.fondation }}</a></p>
</article>
