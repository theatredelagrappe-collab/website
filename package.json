{
  "name": "tgv-website",
  "private": true,
  "description": "Site web du Théâtre de la Grappe de Vétroz",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "eleventy --serve --quiet",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js && eleventy --quiet && node scripts/check-links.js",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "htmlparser2": "^12.0.0",
    "sharp": "^0.35.5"
  }
}
